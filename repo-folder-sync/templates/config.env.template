# Source repository root
SRC_ROOT="__REPO_ROOT__"

# Local destination mirror folder
DST_ROOT="__DEST_ROOT__"

# Runtime and logs are intentionally kept local and excluded from sync.
STATE_DIR="__REPO_ROOT__/.tools/repo-folder-sync/state"
LOG_DIR="__REPO_ROOT__/.tools/repo-folder-sync/logs"

# Debounce window for filesystem watcher (seconds)
WATCHER_DEBOUNCE_SECONDS="2"

# LaunchAgent label used by install/uninstall scripts
LAUNCH_AGENT_LABEL="__LAUNCH_LABEL__"
